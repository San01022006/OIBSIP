{
  "name": "crust-and-craft-server",
  "version": "1.0.0",
  "private": true,
  "description": "Crust & Craft - pizza delivery & inventory management backend (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:menu": "node src/scripts/seedMenu.js",
    "create:admin": "node src/scripts/createAdmin.js",
    "mail:check": "node src/scripts/checkMail.js",
    "lint": "eslint src tests --ext .js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
