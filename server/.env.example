# ─────────────────────────────────────────────────────────────
# Crust & Craft — server environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/crust_and_craft

# Auth / security — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-long-random-secret
# Set to true only when serving over HTTPS in production.
COOKIE_SECURE=false

# Email verification / reset token lifetime (minutes)
EMAIL_TOKEN_TTL_MINUTES=60
RESET_TOKEN_TTL_MINUTES=30

# Mail (Nodemailer).
# Leave SMTP_HOST empty to use the development JSON/console transport: emails
# are NOT delivered, the message is logged to the server console so you can copy
# verification / reset links. This is intentional and never fakes a send.
#
# To deliver real email (e.g. to Gmail), set the values below. Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char Google App Password>   # NOT your normal Gmail password
#   MAIL_FROM="Crust & Craft <you@gmail.com>" # must match SMTP_USER for Gmail
# Verify the configuration with: npm run mail:check
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Crust & Craft <no-reply@crustandcraft.test>"

# Initial admin provisioning (used ONLY by `npm run create:admin`)
ADMIN_NAME=Crust & Craft Admin
ADMIN_EMAIL=admin@crustandcraft.test
ADMIN_PASSWORD=ChangeMe_Str0ng!Pass

# Razorpay — test mode only. Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pricing configuration (INR)
PIZZA_BASE_PRICE=99
DELIVERY_FEE=40
FREE_DELIVERY_THRESHOLD=499
TAX_RATE=0.05

# Inventory scheduler
# Cron expression for the low-stock monitor (default: every 5 minutes)
INVENTORY_CRON=*/5 * * * *
# Set to false to disable the background scheduler entirely
ENABLE_INVENTORY_SCHEDULER=true

# Explicit, clearly-labelled local payment simulator. DISABLED by default.
# When true and NODE_ENV!=production, an alternative "mock" payment provider is
# enabled for local end-to-end testing. This is NOT Razorpay and never fakes a
# real Razorpay charge. Leave false unless you are doing local development.
ENABLE_MOCK_PAYMENTS=false
